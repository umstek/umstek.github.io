---
import type { CollectionEntry } from "astro:content";
import { getPath } from "@/utils/getPath";

export interface Props {
  currentPost: CollectionEntry<"blog">;
  seriesPosts: CollectionEntry<"blog">[];
}

const { currentPost, seriesPosts } = Astro.props;

const seriesName = currentPost.data.series!.name;
const currentPart = currentPost.data.series!.part;

// Combine current post with series posts and sort by part number
const allPosts = [currentPost, ...seriesPosts].sort(
  (a, b) => a.data.series!.part - b.data.series!.part
);
const totalParts = allPosts.length;
---

<nav aria-label="Series navigation" class="my-6 rounded-lg border border-border p-4">
  <div class="mb-3 text-sm font-semibold uppercase tracking-wide opacity-75">
    {seriesName} ({totalParts} parts)
  </div>
  <ol class="space-y-1">
    {
      allPosts.map(post => {
        const isCurrentPost = post.id === currentPost.id;
        return (
          <li>
            <a
              href={getPath(post.id, post.filePath)}
              class={isCurrentPost ? "font-medium text-accent" : "text-foreground/75 hover:text-accent"}
              aria-current={isCurrentPost ? "page" : undefined}
            >
              Part {post.data.series!.part}: {post.data.title}
            </a>
          </li>
        );
      })
    }
  </ol>
</nav>